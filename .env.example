# Copy this to .env and fill in real values once each phase's adapter is built.
# Nothing in the codebase reads these yet except the auth backend section
# below (this session) -- everything else is a template for what's coming.

# --- Auth backend (this session) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required -- the app refuses to start/sign tokens without it (see api/security.py).
SECRET_KEY=

# SQLite by default (no setup needed); point at Postgres when ready:
# DATABASE_URL=postgresql://user:password@localhost:5432/ski_lab
DATABASE_URL=sqlite:///./ski_lab.db

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Search (/trips/search, /trips/search-dates, /trips/resorts) REQUIRES
# a signed-in user by default -- see api/routes/auth.py's module
# docstring for the bearer-token auth flow (register/login/Google, or
# refresh from a stored refresh_token). Set to "true" ONLY for local
# dev/testing when you want to hit search endpoints without registering
# an account first.
# ALLOW_ANONYMOUS_SEARCH=true

# Per-IP burst limit on /trips/search + /trips/search-dates, requests
# per minute. Applies regardless of whether live pricing is involved.
# SEARCH_RATE_LIMIT_PER_MINUTE=6

# GLOBAL (not per-IP) daily cap on how many requests may trigger LIVE
# pricing -- caps how hard the keyless Google Flights/Hotels scraping
# (adapters/google_flights_adapter.py, adapters/google_hotels_adapter.py)
# gets hit, since both carry their own real ban/rate-limit risk (see
# each module's docstring), not any one visitor's usage. See
# rate_limit.py's module docstring for the math behind the default
# (deliberately conservative, not a precise budget meter). Once
# exhausted for the day, search keeps working with static estimates
# instead of erroring.
# MAX_LIVE_SEARCHES_PER_DAY=8

# Where the frontend runs -- used for CORS allow-list and the
# post-login OAuth redirect. Must match exactly (scheme + port).
FRONTEND_URL=http://localhost:3000

# 'console' just prints emails to the server log -- real enough to
# develop and test the verification flow without a real provider.
# Anything else raises until a real provider is wired up (see
# adapters/email_adapter.py).
EMAIL_BACKEND=console

# --- SerpApi: NOT NEEDED for live pricing any more ---
# Neither live flight pricing (adapters/google_flights_adapter.py) nor
# live accommodation pricing (adapters/google_hotels_adapter.py) needs
# a key -- see each module's own docstring for how and why. This key
# only powers the unswapped SerpApi-based fallbacks
# (adapters/flight_adapter.py, adapters/serpapi_hotel_adapter.py),
# which the app doesn't call by default; get one at serpapi.com only if
# you deliberately want to switch a provider back.
SERPAPI_API_KEY=
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=

# --- Phase 5: adapters/accommodation_adapter.py (Booking.com Demand API) ---
# The real long-term accommodation source, but gated behind Booking.com's
# "Managed Affiliate Partner" approval, which is a separate application --
# not available yet (see PROJECT_STATE.md). Until it lands,
# adapters/serpapi_hotel_adapter.py (above) is what's actually wired in.
# BOOKING_AFFILIATE_API_KEY=

# --- Google OAuth (this session's routes/google_oauth.py) ---
# From a Google Cloud Console OAuth 2.0 Client ID (Web application type).
# GOOGLE_REDIRECT_URI below must EXACTLY match what's registered there.
# None of this exists yet -- it's a Google Cloud Console task, not
# something that can be created from this codebase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Phase 6: nlp/preference_parser.py, nlp/explainer.py (LLM version) ---
# ANTHROPIC_API_KEY=

# --- Phase 7: adapters/weather_adapter.py, adapters/snow_adapter.py ---
# OPEN_METEO_API_KEY=   # (Open-Meteo's free tier needs no key; placeholder if a paid tier is used)
